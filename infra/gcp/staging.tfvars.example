# Copy to the ignored staging.auto.tfvars and replace this value.
project_id = "replace-with-staging-project-id"

# India-first staging. Changing region later requires a data migration.
region      = "asia-south1"
environment = "staging"

# Synthetic raw chunks only. Production retention is a separate reviewed policy.
raw_retention_days = 30

# Explicit user-submitted diagnostics only. Never upload participant health data.
feedback_retention_days = 28
enable_feedback_lifecycle = false
enable_feedback_ingestion = false
feedback_external_abuse_gate_approved = false

# Keep these false/null through the foundation apply. Enable the database only
# after the standard-PostgreSQL integration suite passes.
enable_managed_database = false
database_tier           = "db-f1-micro"

# Build from a clean commit, then use the Artifact Registry digest URI rather
# than a mutable tag. The digest enables the migration job.
runtime_image = null

# Enable only after the migration job succeeds. The service has internal
# ingress, IAM authentication, a /readyz startup probe, and no public invoker.
enable_private_api = false

# After Firebase identity, App Check, migrations, and the managed test suite
# pass, deploy the managed API/processor/lifecycle with Cloud Run IAM still
# required. Public mobile invocation is a separate final gate.
enable_managed_identity             = false
enable_managed_app_check            = false
managed_auth_app_check_enforcement  = "UNENFORCED"
# Ownership uses the same Firebase apps but a separate named client session and
# backend. This flag enables email/password only; it does not enable a runtime.
enable_ownership_identity           = false
# Put only Firebase synthetic test credentials here in the ignored local
# staging.auto.tfvars. Never use or commit a real person's phone number.
managed_test_phone_numbers          = {}
enable_managed_runtime              = false
enable_public_managed_api           = false
# The ownership runtime remains IAM-only and its production possession verifier
# intentionally returns unavailable until the supplier SDK is integrated.
enable_ownership_runtime            = false
# Existing secret ID only, never a URL or password. Its PostgreSQL role must
# have access to ownership_* objects and no managed-health or Safety tables.
ownership_database_url_secret_id    = null
