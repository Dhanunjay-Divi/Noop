{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noop.example/spec/band-capabilities-v1.schema.json",
  "title": "NOOP Band Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "hardwareRevision",
    "firmwareVersion",
    "historyDays",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "protocolVersion": {
      "const": "noop-band-v1"
    },
    "hardwareRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "firmwareVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "historyDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "battery",
          "charging",
          "wear_state",
          "steps",
          "distance",
          "calories",
          "heart_rate",
          "rr_intervals",
          "sleep",
          "spo2",
          "respiration",
          "temperature",
          "stress",
          "workout_history",
          "raw_ppg",
          "accelerometer",
          "gyroscope",
          "haptics",
          "alarms",
          "weather",
          "firmware_update"
        ]
      }
    }
  }
}
