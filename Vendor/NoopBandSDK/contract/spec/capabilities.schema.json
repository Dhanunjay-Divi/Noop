{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noop.example/spec/band-capabilities-v2.schema.json",
  "title": "NOOP Band Capabilities",
  "$comment": "x-noop-maxUtf8Bytes is the normative cross-platform string bound; maxLength remains a generic-validator upper bound.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "historyStreams": {
            "minItems": 1
          }
        },
        "required": [
          "historyStreams"
        ]
      },
      "then": {
        "properties": {
          "historyDays": {
            "minimum": 1
          }
        }
      }
    }
  ],
  "required": [
    "schemaVersion",
    "protocolVersion",
    "hardwareRevision",
    "firmwareVersion",
    "historyDays",
    "capabilities",
    "liveStreams",
    "historyStreams"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "protocolVersion": {
      "const": "noop-band-v1"
    },
    "hardwareRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "x-noop-maxUtf8Bytes": 32
    },
    "firmwareVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-noop-maxUtf8Bytes": 64
    },
    "historyDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "battery",
          "charging",
          "wear_state",
          "steps",
          "distance",
          "calories",
          "heart_rate",
          "rr_intervals",
          "sleep",
          "spo2",
          "respiration",
          "temperature",
          "stress",
          "workout_history",
          "raw_ppg",
          "accelerometer",
          "gyroscope",
          "haptics",
          "alarms",
          "weather",
          "firmware_update"
        ]
      }
    },
    "liveStreams": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "heartRate",
          "rrInterval",
          "steps",
          "spo2",
          "respiration",
          "temperature",
          "acceleration"
        ]
      }
    },
    "historyStreams": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "heartRate",
          "rrInterval",
          "steps",
          "spo2",
          "respiration",
          "temperature",
          "acceleration"
        ]
      }
    }
  }
}
