    "launch.locked.inline": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"NOOP · Auf dem iPhone entsperren"}},"en":{"stringUnit":{"state":"translated","value":"NOOP · Unlock on iPhone"}},"es":{"stringUnit":{"state":"translated","value":"NOOP · Desbloquea en el iPhone"}},"fr":{"stringUnit":{"state":"translated","value":"NOOP · Déverrouiller sur l’iPhone"}},"it":{"stringUnit":{"state":"translated","value":"NOOP · Sblocca su iPhone"}},"pt-PT":{"stringUnit":{"state":"translated","value":"NOOP · Desbloquear no iPhone"}},"ru":{"stringUnit":{"state":"translated","value":"NOOP · Разблокируйте на iPhone"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"NOOP · 在 iPhone 上解锁"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"NOOP · 在 iPhone 上解鎖"}}}},
