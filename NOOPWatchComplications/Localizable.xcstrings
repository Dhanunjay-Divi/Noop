    "NOOP. No data yet, open NOOP on your iPhone to sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NOOP. Noch keine Daten, öffne NOOP auf deinem iPhone zum Synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NOOP. No data yet, open NOOP on your iPhone to sync."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO. Ainda não há dados, abra o NOOP no teu iPhone para tincronizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NOOP. Данных пока нет, откройте NOOP на iPhone для синхронизации."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NOOP. Aún no hay datos, abra NOOP en su iPhone para sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "- Oui. Pas encore de données, ouvrez NOOP sur votre iPhone pour synchroniser."
          }
        }
      }
    },
    "NOOP. Scores out of date, last synced %@. Open NOOP on iPhone to refresh.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NOOP. Werte veraltet, zuletzt synchronisiert %@. Öffne NOOP auf dem iPhone zum Aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NOOP. Scores out of date, last synced %@. Open NOOP on iPhone to refresh."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO. Pontuações desatualizadas, última sincronização %@. Abra o NOOP no iPhone para atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NOOP. Показатели устарели, последняя синхронизация %@. Откройте NOOP на iPhone, чтобы обновить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NOOP. Resultados fuera de la fecha, último sincronizado %1$@. Abra NOOP en iPhone para refrescarse."
