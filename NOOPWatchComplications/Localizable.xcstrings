        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "- Oui. Les scores sont dépassés, le dernier %1$@ synchronisé. Ouvrez NOOP sur iPhone pour vous rafraîchir."
          }
        }
      }
    },
