    <string name="friends_server_title">Hoste deinen privaten Kreis</string>
    <string name="friends_server_body">Friends läuft auf einem Noop-Server, den du kontrollierst. Es gibt kein Noop-Konto und kein öffentliches Profil.</string>
    <string name="friends_server_setup_action">Server einrichten</string>
    <string name="friends_join_details">Einladungsdaten eingeben</string>
    <string name="friends_server_invite_note">Eine Einladung enthält eine Serveradresse und einen Einmalcode. Du kannst ohne Administratorschlüssel beitreten.</string>
    <string name="friends_pending_title">Einladung abschließen</string>
    <string name="friends_pending_body">Noop hat diesen Beitrittsversuch gespeichert, weil die Serverantwort unterbrochen wurde. Versuche es mit demselben Einmalcode erneut oder lösche sicher jedes dabei erstellte Serverprofil.</string>
    <string name="friends_pending_retry">Einladung erneut versuchen</string>
    <string name="friends_pending_discard">Diesen Versuch abbrechen</string>
    <string name="friends_pending_discard_title">Diesen Beitrittsversuch abbrechen?</string>
    <string name="friends_pending_discard_body">Noop fordert den Server auf, alle mit dieser ausstehenden Anmeldung verknüpften Profile und Friends-Zusammenfassungen zu löschen, bevor die geschützten Zugangsdaten von diesem Gerät entfernt werden.</string>
    <string name="friends_pending_discard_action">Versuch löschen</string>
    <string name="friends_profile_title">Privates Profil erstellen</string>
    <string name="friends_profile_body">Dein Name ist nur für bestätigte Freunde auf %1$s sichtbar.</string>
    <string name="friends_display_name">Anzeigename</string>
    <string name="friends_create_profile">Privates Profil erstellen</string>
    <string name="friends_profile_security_note">Der Administratorschlüssel wird einmalig verwendet, um separate Mitgliedsdaten auszustellen. Friends ist nicht Ende-zu-Ende-verschlüsselt. Nutze daher einen vertrauenswürdigen Serverbetreiber.</string>

