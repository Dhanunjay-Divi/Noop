    <string name="friends_join_trust_title">Vertrauen in den Betreiber</string>
    <string name="friends_join_trust_body">Friends ist nicht Ende-zu-Ende-verschlüsselt. Der Betreiber des selbst gehosteten Servers kann auf die von dir freigegebenen Zusammenfassungsfelder zugreifen.</string>
