    <string name="friends_privacy_title">Bewusst nur Zusammenfassungen</string>
    <string name="friends_privacy_body">Roher Herzschlag, R-R-Intervalle, Schlafphasen, Tagebücher, Trainings, Routen, Exporte und Gerätekennungen erscheinen nie in Friends.</string>
    <string name="friends_leave_action">Kreis verlassen und Serverkopie löschen</string>
    <string name="friends_leave_title">Diesen Kreis verlassen?</string>
    <string name="friends_leave_body">Noop entfernt Freundschaften, Mitgliedsdaten und eigene Friends-Zusammenfassungen von diesem Server. Gesundheitsdaten auf dem Gerät und dein separates Backup bleiben erhalten.</string>

    <string name="friends_invite_title">Freund einladen</string>
    <string name="friends_invite_body">Einmaliger Zugang zu deinem privaten Kreis.</string>
    <string name="friends_invite_expires">Läuft am %1$s ab</string>
    <string name="friends_invite_share">Einladung teilen</string>
    <string name="friends_invite_subject">Tritt meinem privaten Noop-Kreis bei</string>
    <string name="friends_invite_share_text">Tritt meinem privaten Noop-Kreis bei.\n\nServer: %1$s\nEinmalcode: %2$s\n\nÖffne in Noop Mehr &gt; Freunde &gt; Einladungsdaten eingeben. Die Freigabe beginnt erst, nachdem ich deine Anfrage angenommen habe.</string>
    <string name="friends_invite_disclosure">Der Code läuft innerhalb von 72 Stunden ab und funktioniert einmal. Der Beitritt erstellt eine Anfrage; du entscheidest weiterhin über die Annahme.</string>
    <string name="friends_join_title">Einem Kreis beitreten</string>
    <string name="friends_join_body">Prüfe Ziel und Hinweise, bevor du eine Anfrage sendest.</string>
