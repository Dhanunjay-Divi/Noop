    <string name="friends_server_title">託管你的私人圈子</string>
    <string name="friends_server_body">好友功能在你控制的 Noop 伺服器上運作，不需要 Noop 帳號，也沒有公開個人檔案。</string>
    <string name="friends_server_setup_action">設定伺服器</string>
    <string name="friends_join_details">輸入邀請資料</string>
    <string name="friends_server_invite_note">邀請包含伺服器位址和單次使用代碼。加入時不需要伺服器管理員金鑰。</string>
    <string name="friends_pending_title">完成邀請</string>
    <string name="friends_pending_body">伺服器回應中斷，因此 Noop 已儲存這次加入嘗試。請使用相同的單次代碼重試，或安全刪除此嘗試在伺服器上建立的任何個人檔案。</string>
    <string name="friends_pending_retry">重試邀請</string>
    <string name="friends_pending_discard">取消這次嘗試</string>
    <string name="friends_pending_discard_title">取消這次加入嘗試？</string>
    <string name="friends_pending_discard_body">從此裝置移除受保護的憑證前，Noop 會要求伺服器刪除與這項待處理註冊相關的任何個人檔案和 Friends 摘要。</string>
    <string name="friends_pending_discard_action">刪除這次嘗試</string>
    <string name="friends_profile_title">建立私人個人檔案</string>
    <string name="friends_profile_body">只有 %1$s 上已接受的好友能看到你的名稱。</string>
    <string name="friends_display_name">顯示名稱</string>
