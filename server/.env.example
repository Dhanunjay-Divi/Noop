# Generate each secret independently, for example:
#   openssl rand -hex 32
# This intentionally fails API startup until replaced (the token must be >=32 bytes).
NOOP_API_TOKEN=replace-me
# single_owner keeps the administrator token compatible with one trusted
# installation. shared requires per-installation credentials for biometric data.
NOOP_AUTH_MODE=single_owner
NOOP_EXPORT_MAX_ROWS=100000
NOOP_DB_PASSWORD=replace-me
NOOP_DB_NAME=noop
# Local Compose uses TimescaleDB. Managed Cloud SQL uses postgresql and the
# separately checksummed standard-PostgreSQL initial migration.
NOOP_DATABASE_ENGINE=timescaledb
NOOP_DB_POOL_MIN_SIZE=1
NOOP_DB_POOL_MAX_SIZE=8
# Set to 0 when runtime traffic uses PgBouncer transaction pooling.
NOOP_DB_STATEMENT_CACHE_SIZE=100
# Production can override each service independently with a URL-encoded
# least-privilege role. Blank values keep the single-host Compose default.
NOOP_MIGRATION_DATABASE_URL=
NOOP_API_DATABASE_URL=
NOOP_SAFETY_WORKER_DATABASE_URL=

# The published API port remains bound to this computer's loopback interface.
NOOP_PORT=8080

# 0 keeps all data. A positive number enables scheduled and explicit retention.
NOOP_RETENTION_DAYS=0
NOOP_RETENTION_INTERVAL_HOURS=24
NOOP_IDEMPOTENCY_REPLAY_GUARD_DAYS=30
NOOP_RATE_LIMIT_REQUESTS_PER_MINUTE=120
NOOP_RATE_LIMIT_ORIGIN_REQUESTS_PER_MINUTE=300
NOOP_RATE_LIMIT_PROVIDER_CALLBACK_PRE_AUTH_REQUESTS_PER_MINUTE=12000
NOOP_RATE_LIMIT_PROVIDER_CALLBACK_REQUESTS_PER_MINUTE=6000
NOOP_RATE_LIMIT_MAX_KEYS=10000
# Exact API-gateway/LB source IPs or CIDRs, comma-separated. Never use "*".
NOOP_FORWARDED_ALLOW_IPS=127.0.0.1
NOOP_DASHBOARD_ENABLED=true

# Optional managed app-to-app Safety push. The token secret encrypts FCM
# registration tokens at rest and must be independent from the managed replay
# secret. Core local collection and metrics do not depend on this path.
NOOP_MANAGED_PUSH_ENABLED=false
# The private lifecycle job may retry due app-to-app Safety deliveries even
# when it does not host the managed API.
NOOP_MANAGED_PUSH_RETRY_ENABLED=false
NOOP_MANAGED_PUSH_TOKEN_SECRET=
NOOP_MANAGED_PUSH_TIMEOUT_SECONDS=5
NOOP_MANAGED_PUSH_MAX_CONCURRENCY=6

# Separate first-party NOOP Band ownership authority. Keep disabled until the
# approved supplier possession verifier, immutable terms, least-privilege
# database role, App Check, legal, recovery, and physical-device gates pass.
NOOP_OWNERSHIP_SERVICE_ENABLED=false
NOOP_OWNERSHIP_PROJECT_ID=
NOOP_OWNERSHIP_PROJECT_NUMBER=
NOOP_OWNERSHIP_IDENTITY_API_KEY=
NOOP_OWNERSHIP_APPLE_APP_ID=
NOOP_OWNERSHIP_ANDROID_APP_ID=
NOOP_OWNERSHIP_IDENTITY_CACHE_SECONDS=300
NOOP_OWNERSHIP_IDENTITY_CACHE_ENTRIES=10000
NOOP_OWNERSHIP_APP_CHECK_CACHE_SECONDS=21600
NOOP_OWNERSHIP_CHALLENGE_TTL_SECONDS=180
NOOP_OWNERSHIP_FRESH_AUTH_SECONDS=600

# Optional acknowledged Safety Network paging. Leave every value blank to keep
# paging disabled. If enabled, all six values are required and the public origin
# must terminate trusted HTTPS.
NOOP_PUBLIC_BASE_URL=
NOOP_TWILIO_ACCOUNT_SID=
NOOP_TWILIO_AUTH_TOKEN=
# Optional least-privilege outbound credential. Configure both or neither.
NOOP_TWILIO_API_KEY_SID=
NOOP_TWILIO_API_KEY_SECRET=
NOOP_TWILIO_FROM_PHONE=
NOOP_TWILIO_STATUS_CALLBACK_SECRET=
NOOP_SAFETY_CAPABILITY_SECRET=

# Paging policy. Incidents share only the newest location for the selected 8 or
# 12 hours, so the deployment ceiling must be at least 43200 seconds. Each round
# queues independent SMS and delayed voice jobs; acknowledgement cancels all
# unsent rounds. Automatic fall transport is hard-disabled in this release even
# if the preparatory flag and allowlist below are set. Keep both inactive until
# authenticated detector attestation and every physical-device, carrier,
# human-factors, legal, and regulatory gate are implemented and passed.
NOOP_SAFETY_ACKNOWLEDGEMENT_TIMEOUT_SECONDS=90
NOOP_SAFETY_INCIDENT_TTL_SECONDS=43200
NOOP_SAFETY_ESCALATION_ROUNDS=4
NOOP_SAFETY_ESCALATION_INTERVAL_SECONDS=900
NOOP_SAFETY_AUTOMATIC_PAGING_ENABLED=false
# Reserved comma-separated detector_id:version metadata. An allowlist is not
# detector authentication or validation evidence and cannot enable transport.
NOOP_SAFETY_APPROVED_FALL_DETECTORS=
# The heartbeat timeout must exceed the poll interval. The delivery lease must
# exceed the provider request timeout plus the poll interval.
NOOP_SAFETY_WORKER_POLL_SECONDS=2
NOOP_SAFETY_WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
NOOP_SAFETY_DELIVERY_LEASE_SECONDS=30
NOOP_SAFETY_RETRY_BASE_SECONDS=5
NOOP_SAFETY_PROVIDER_REQUEST_TIMEOUT_SECONDS=15
NOOP_SAFETY_PROVIDER_RECEIPT_TIMEOUT_SECONDS=300
NOOP_SAFETY_WORKER_BATCH_SIZE=20
# Must be smaller than NOOP_DB_POOL_MAX_SIZE because each in-flight submission
# holds a database-backed paging permit.
NOOP_SAFETY_WORKER_MAX_CONCURRENCY=6
NOOP_SAFETY_MAINTENANCE_BATCH_SIZE=200
# Shared across worker replicas through a database-backed sender slot.
NOOP_SAFETY_PROVIDER_MAX_REQUESTS_PER_SECOND=5
NOOP_SAFETY_MONITORING_WINDOW_SECONDS=86400
# Terminal incidents and inactive contacts only. Retention is opt-in: replace 0
# with an approved number of days. Accepted contacts and active incidents are
# never aged.
NOOP_SAFETY_INCIDENT_RETENTION_DAYS=0
NOOP_SAFETY_CONTACT_RETENTION_DAYS=0
NOOP_SAFETY_RETENTION_INTERVAL_HOURS=24
NOOP_SAFETY_RETENTION_MAX_BATCHES_PER_RUN=20
# Compose-only duration. Keep this longer than the provider request timeout so
# normal deploys can persist an in-flight outcome before the worker is killed.
NOOP_SAFETY_WORKER_STOP_GRACE_PERIOD=45s

# Create this untracked file with at least 32 random bytes before Compose start.
NOOP_BACKUP_SECRET_FILE=./secrets/backup-passphrase.txt
NOOP_BACKUP_INTERVAL_SECONDS=86400
NOOP_BACKUP_RETENTION_DAYS=30
NOOP_BACKUP_TMPFS_SIZE=2g
# Use a read-only backup role in production. Blank values use the local
# Compose database owner and NOOP_DB_PASSWORD.
NOOP_BACKUP_DB_USER=
NOOP_BACKUP_DB_PASSWORD=
