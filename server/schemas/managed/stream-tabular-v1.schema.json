{
  "$id": "noop-schema://managed/stream-tabular-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "columns": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "rows": {
      "items": {
        "maxItems": 128,
        "minItems": 1,
        "type": "array"
      },
      "type": "array"
    },
    "schema_revision": {
      "maximum": 10000,
      "minimum": 1,
      "type": "integer"
    },
    "stream_key": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "type": "string"
    }
  },
  "required": [
    "stream_key",
    "schema_revision",
    "columns",
    "rows"
  ],
  "title": "NOOP managed tabular stream v1",
  "type": "object"
}
