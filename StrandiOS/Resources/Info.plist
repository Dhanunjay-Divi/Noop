			<array>
				<string>noop</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(NOOP_MANAGED_ENCODED_APP_ID)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
