	<key>NOOPManagedDisablePhoneAppVerification</key>
	<string>$(NOOP_MANAGED_DISABLE_PHONE_APP_VERIFICATION)</string>
	<key>NOOPManagedGCMSenderID</key>
	<string>$(NOOP_MANAGED_GCM_SENDER_ID)</string>
	<key>NOOPManagedGoogleAppID</key>
	<string>$(NOOP_MANAGED_GOOGLE_APP_ID)</string>
	<key>NOOPManagedPolicySHA256</key>
	<string>$(NOOP_MANAGED_POLICY_SHA256)</string>
	<key>NOOPManagedPolicyVersion</key>
	<string>$(NOOP_MANAGED_POLICY_VERSION)</string>
	<key>NOOPManagedProjectID</key>
	<string>$(NOOP_MANAGED_PROJECT_ID)</string>
	<key>NOOPManagedTestPhone</key>
	<string>$(NOOP_MANAGED_TEST_PHONE)</string>
	<key>NOOPOwnershipAPIURL</key>
	<string>$(NOOP_OWNERSHIP_API_URL)</string>
	<key>NOOPOwnershipActivationEnabled</key>
	<string>$(NOOP_OWNERSHIP_ACTIVATION_ENABLED)</string>
	<key>NOOPOwnershipAllowLocalHTTP</key>
	<string>$(NOOP_OWNERSHIP_ALLOW_LOCAL_HTTP)</string>
	<key>NOOPOwnershipTermsHost</key>
	<string>$(NOOP_OWNERSHIP_TERMS_HOST)</string>
	<key>NOOPStrengthMediaURLTemplate</key>
	<string>$(NOOP_STRENGTH_MEDIA_URL_TEMPLATE)</string>
	<key>NOOPStrengthVideoURLTemplate</key>
	<string>$(NOOP_STRENGTH_VIDEO_URL_TEMPLATE)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>NOOP connects directly to your wearable and standards-compatible Bluetooth health devices, including an explicitly paired weight scale, to store sensor data locally. It uploads selected data only if you explicitly enable NOOP+ managed backup or your own self-hosted server.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>If you enable planned-workout guidance, NOOP checks upcoming calendar titles on-device to find a likely workout. It keeps only the workout time and never stores event titles, attendees, notes, locations, or identifiers.</string>
	<key>NSCameraUsageDescription</key>
	<string>NOOP uses the camera only while you explicitly scan a food barcode. Images and video are processed on-device and are not stored.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>NOOP reads your Apple Health data to compute metrics locally. Nothing leaves unless you explicitly enable it: selected records can go to NOOP+ managed backup or your own self-hosted server, and Coach sends a short text summary only to the AI provider you choose after you add your own key and allow it.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>NOOP writes the metrics it computes from your band back into Apple Health, along with workouts and sleep sessions, on-device and only when you allow it.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>NOOP connects to a self-hosted server on your local network only when you configure and enable that optional sync.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Always location access lets NOOP update the newest fix for accepted contacts during an active 8- or 12-hour Safety page, including one started from a configured band SOS gesture. NOOP keeps no route history and stops when the page ends.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>NOOP uses location for Today weather, an outdoor-workout route, a safety message, or an active Safety page. Safety shares only the newest fix with accepted contacts.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>NOOP uses the microphone only while you explicitly dictate a Coach question or journal draft. Audio is transcribed by the system and is not stored by NOOP.</string>
	<key>NSMotionUsageDescription</key>
	<string>NOOP reads your iPhone's step count for activity summaries. It uploads selected records only if you explicitly enable NOOP+ managed backup or your own self-hosted server.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>NOOP uses system speech recognition only while you explicitly dictate a Coach question or journal draft.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>OURA_CLIENT_ID</key>
	<string>$(OURA_CLIENT_ID)</string>
	<key>OURA_REDIRECT_URI</key>
	<string>$(OURA_REDIRECT_URI)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
