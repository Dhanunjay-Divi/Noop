<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>NOOP</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>NOOP</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>noop</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>FirebaseAppCheckTokenAutoRefreshEnabled</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.healthcare-fitness</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NOOPManagedAPIKey</key>
	<string>$(NOOP_MANAGED_API_KEY)</string>
	<key>NOOPManagedAPIURL</key>
	<string>$(NOOP_MANAGED_API_URL)</string>
	<key>NOOPManagedAllowLocalHTTP</key>
	<string>$(NOOP_MANAGED_ALLOW_LOCAL_HTTP)</string>
	<key>NOOPManagedGCMSenderID</key>
	<string>$(NOOP_MANAGED_GCM_SENDER_ID)</string>
	<key>NOOPManagedGoogleAppID</key>
	<string>$(NOOP_MANAGED_MACOS_GOOGLE_APP_ID)</string>
	<key>NOOPManagedPolicySHA256</key>
	<string>$(NOOP_MANAGED_POLICY_SHA256)</string>
	<key>NOOPManagedPolicyVersion</key>
	<string>$(NOOP_MANAGED_POLICY_VERSION)</string>
	<key>NOOPManagedProjectID</key>
	<string>$(NOOP_MANAGED_PROJECT_ID)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>NOOP connects directly to your wearable and standards-compatible Bluetooth health devices, including an explicitly paired weight scale, to store sensor data locally. It uploads decoded data only if you explicitly enable your own self-hosted server.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>NOOP connects to a self-hosted server on your local network only when you configure and enable that optional sync.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>NOOP uses location when you request an outdoor-workout route or choose to add one current location to a safety message. It stays on your device unless you deliberately share that message.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>NOOP uses the microphone only while you explicitly dictate a Coach question or journal draft. Audio is transcribed by the system and is not stored by NOOP.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>NOOP uses system speech recognition only while you explicitly dictate a Coach question or journal draft.</string>
	<key>OURA_CLIENT_ID</key>
	<string>$(OURA_CLIENT_ID)</string>
	<key>OURA_REDIRECT_URI</key>
	<string>$(OURA_REDIRECT_URI)</string>
</dict>
</plist>
