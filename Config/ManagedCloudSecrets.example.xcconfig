// Copy to Config/ManagedCloudSecrets.xcconfig after applying the synthetic
// staging identity stack. Never point a development build at production data.
NOOP_MANAGED_PROJECT_ID = replace-with-project-id
NOOP_MANAGED_API_KEY = replace-with-restricted-firebase-api-key
NOOP_MANAGED_GOOGLE_APP_ID = replace-with-firebase-apple-app-id
NOOP_MANAGED_GCM_SENDER_ID = replace-with-project-number
// Firebase Auth fallback callback scheme:
// app-<GOOGLE_APP_ID with each colon replaced by a hyphen>
NOOP_MANAGED_ENCODED_APP_ID = app-replace-with-dashed-firebase-apple-app-id
NOOP_MANAGED_API_URL = https:/$()/replace-with-managed-cloud-run-host
NOOP_MANAGED_POLICY_VERSION = synthetic-v1
NOOP_MANAGED_POLICY_SHA256 = e9324e49b411f124635c24b2de509f4e459cb164b7bdd23519c65c778d12d7ef
// Debug simulator pilot only. Release builds ignore these switches.
NOOP_MANAGED_ALLOW_LOCAL_HTTP = NO
NOOP_MANAGED_DISABLE_PHONE_APP_VERIFICATION = NO
NOOP_MANAGED_TEST_PHONE =

// Separate first-party band ownership authority. Keep activation disabled
// until an approved supplier possession verifier and physical-band gates pass.
NOOP_OWNERSHIP_API_URL = https:/$()/replace-with-ownership-cloud-run-host
NOOP_OWNERSHIP_TERMS_HOST = replace-with-terms-object-host
NOOP_OWNERSHIP_ACTIVATION_ENABLED = NO
NOOP_OWNERSHIP_ALLOW_LOCAL_HTTP = NO
