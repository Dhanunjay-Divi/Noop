// Copying this file by hand is unnecessary; use Tools/generate-launch-gate-verifier.py instead.
// This iPhone-only template intentionally contains no usable verifier material. The non-secret
// required/version policy lives in LaunchGate.xcconfig and is inherited by every embedded surface.
NOOP_LAUNCH_GATE_SALT_HEX = replace-with-32-hex-characters
NOOP_LAUNCH_GATE_VERIFIER_HEX = replace-with-64-hex-characters
NOOP_LAUNCH_GATE_ITERATIONS = 310000
