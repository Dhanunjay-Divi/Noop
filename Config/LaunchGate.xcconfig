// Temporary launch-access gate policy shared by the iPhone app and its user-facing extensions.
// This file is intentionally public and contains only the required/version contract. The ignored
// verifier configuration is included exclusively by Config/NOOPiOS.xcconfig so widgets and Watch
// targets never inherit verifier, salt, or iteration build settings.
//
// Generate the matching ignored iPhone-only verifier configuration interactively with:
//   python3 Tools/generate-launch-gate-verifier.py <new-version>
//
// REQUIRED remains NO for ordinary source builds. Every embedded Release target overrides it to YES;
// set those overrides to NO together when retiring the gate in an in-place update.
NOOP_LAUNCH_GATE_REQUIRED = NO
NOOP_LAUNCH_GATE_VERSION = appstore-2026-08-25-v1
